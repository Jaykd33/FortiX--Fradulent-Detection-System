# =========================
# FortiX Backend - .env.example
# Copy to .env and customize.
# =========================

# --- Server ---
FORTIX_ENV=dev
LOG_LEVEL=INFO
API_PREFIX=/api
# Optional: host/port if your app reads them
HOST=0.0.0.0
PORT=8000

# --- Database ---
# Use a local dockerized Postgres by default. Replace CHANGE_ME if needed.
DATABASE_URL="postgresql+asyncpg://postgres:jay.k.d33@localhost/fortix_db"

# Alt (commented): SQLite fallback if your code supports it
# DATABASE_URL=sqlite+aiosqlite:///./fortix.db

# --- CORS (optional) ---
# Comma-separated origins, e.g. http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- ML Model ---
# Primary model path (preferred)
MODEL_PATH=ml_models/fraud_model.joblib
# Back-compat var if some modules use this name
FRAUD_MODEL_PATH=ml_models/fraud_model.joblib
# If true and model missing, run rules-only or a dummy model path
USE_DUMMY_MODEL=true

# --- Fraud Scoring Rules ---
# Threshold at/above which a transaction is flagged
ALERT_THRESHOLD=70

# --- Security (optional; add if you implement auth later) ---
# SECRET_KEY=CHANGE_ME_SUPER_SECRET
# ACCESS_TOKEN_EXPIRE_MINUTES=60
